{
  "name": "xander-school-desktop",
  "version": "1.0.4",
  "description": "Xander School offline desktop app with SQLite sync",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run build && electron-builder",
    "dist": "npm run dist:win",
    "dist:win": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "fetch-php": "powershell -ExecutionPolicy Bypass -File ./scripts/fetch-php.ps1",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || echo native rebuild skipped",
    "preview": "electron-vite preview"
  },
  "keywords": [
    "electron",
    "xander",
    "school",
    "offline",
    "sqlite"
  ],
  "author": "Xander School",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "lucide-react": "^0.394.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.xander.school.desktop",
    "productName": "Xander School",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "files": [
      "out/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "school/app"
      },
      {
        "from": "../public",
        "to": "school/public",
        "filter": [
          "**/*",
          "!assets/images/profile/**"
        ]
      },
      {
        "from": "../system",
        "to": "school/system"
      },
      {
        "from": "../deploy",
        "to": "school/deploy",
        "filter": ["**/*.sql"]
      },
      {
        "from": "php-runtime",
        "to": "php-runtime",
        "filter": [
          "**/*",
          "!.gitkeep"
        ]
      }
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Xander School",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
